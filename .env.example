# ============================================================================
# GWO (goodwithonline.com) — Plug-and-Play Environment Configuration
# All keys below are OPTIONAL for local development! When omitted, GWO runs in
# Zero-Key Studio Demo Mode backed by data/local-db.json & studio compositing.
# ============================================================================

# 1. Supabase (Postgres Shared Catalog, Friend Closets, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Virtual Try-On Engine (FASHN AI v1.6 via fal.ai — $0.075/render)
FAL_KEY=

# 3. Single-URL Boutique Scraper (Firecrawl /scrape — falls back to JSON-LD/Shopify)
FIRECRAWL_API_KEY=

# 4. Optional LLM Stylist Upgrade (Gemini or OpenAI)
GEMINI_API_KEY=

# 5. Affiliate Link Monetization (Skimlinks / CJ Affiliate)
SKIMLINKS_PUBLISHER_ID=
CJ_WEBSITE_ID=

# 6. Monthly Free-Beta Compute Guardrail ($100.00 hard ceiling)
GWO_MONTHLY_BUDGET_USD=100
GWO_DAILY_FREE_TRYONS=6
